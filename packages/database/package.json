{
  "name": "@workspace/db",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "bunx prisma generate",
    "db:gen": "bunx prisma generate",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test adapter.test.ts",
    "db:seed": "bunx prisma db seed",
    "db:pull": "bunx prisma db pull",
    "migrate:dev": "bunx prisma migrate dev",
    "migrate:reset": "bunx prisma migrate reset",
    "migrate:prod": "bunx prisma migrate deploy",
    "migrate:createonly": "bunx prisma migrate dev --create-only"
  },
  "devDependencies": {
    "@types/node": "^25.0.9",
    "prisma": "^7.10.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@prisma/adapter-neon": "^7.10.1",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "dotenv": "^17.2.3"
  }
}
